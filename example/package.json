{
  "name": "zs-ui-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "start": "expo start",
    "sync:local": "node scripts/sync-local-package.mjs",
    "ios": "pnpm run sync:local && expo run:ios",
    "ios:device": "pnpm run sync:local && expo run:ios --device",
    "android": "pnpm run sync:local && expo run:android",
    "web": "pnpm run sync:local && expo start --web",
    "build:web": "pnpm run sync:local && expo export --platform web",
    "test:e2e:web": "node scripts/web-e2e.mjs"
  },
  "dependencies": {
    "@0610studio/expo-skia-date-wheel-picker": "^0.1.1",
    "@0610studio/zs-ui": "workspace:*",
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.14",
    "expo-modules-core": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.11.1",
    "expo": "57.0.18",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.14",
    "agent-browser": "0.35.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
