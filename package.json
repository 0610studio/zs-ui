{
  "name": "@0610studio/zs-ui",
  "version": "2.4.0",
  "packageManager": "pnpm@10.16.1",
  "private": false,
  "description": "Expo SDK 58용 iOS·Android UI 라이브러리",
  "type": "commonjs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/.tsbuildinfo",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "ios",
    "expo-module.config.json",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start:android": "pnpm install && pnpm --filter zs-ui-example run android",
    "start:ios": "pnpm install && pnpm --filter zs-ui-example run ios",
    "start:ios:device": "pnpm install && pnpm --filter zs-ui-example run ios:device",
    "build": "expo-module build",
    "prepare": "expo-module prepare",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs --deny-warnings",
    "typecheck": "tsc --noEmit && pnpm typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "CI=true expo-module test --watchAll=false",
    "test:cov": "CI=true expo-module test --coverage",
    "prepublishOnly": "expo-module prepublishOnly",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "zs-ui",
    "ZsUi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0610studio/zs-ui.git"
  },
  "author": "0610studio <0610studio@naver.com>",
  "license": "MIT",
  "homepage": "https://github.com/0610studio/zs-ui",
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "expo-hinge": "~58.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@expo/log-box": "~58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "expo": "58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-module-scripts": "56.0.8",
    "expo-modules-core": "~58.1.0",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "jest": "^30",
    "jest-expo": "~58.0.15",
    "oxlint": "1.93.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-skia": "3.10.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "test-renderer": "~1.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.29",
    "@react-native-async-storage/async-storage": "*",
    "expo": ">=58.0.26",
    "expo-blur": ">=58.0.0",
    "expo-navigation-bar": ">=58.0.0",
    "expo-router": ">=58.0.32",
    "expo-status-bar": ">=58.0.4",
    "expo-symbols": ">=58.0.0",
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": ">=3.2.0 <4.0.0",
    "react-native-reanimated": ">=4.7.0 <5.0.0",
    "react-native-safe-area-context": ">=5.9.0",
    "react-native-screens": ">=4.30.0",
    "react-native-skia": ">=3.0.0",
    "react-native-svg": "*",
    "react-native-worklets": ">=0.13.0 <0.14.0"
  },
  "peerDependenciesMeta": {
    "expo-symbols": {
      "optional": true
    }
  }
}
